<% content_for :title, "ประวัติการชำระ | พักดี" %>
<header class="topbar page-heading"><div><p class="eyebrow">PAYMENT HISTORY</p><h1>ประวัติการชำระเงิน</h1><p class="muted">ตรวจสอบรายการบิลและสถานะการชำระย้อนหลัง</p></div><%= link_to billing_path, class: "button button-primary" do %><span>＋</span> รอบบิลปัจจุบัน<% end %></header>
<section class="content-card recent-card"><div class="list-toolbar"><div><strong><%= @invoices.count %> รายการ</strong><span class="muted"> บิลทั้งหมด</span></div><span class="status-pill status-paid">ชำระแล้ว <%= @invoices.count(&:paid?) %> รายการ</span></div><% if @invoices.any? %><div class="table-wrap"><table><thead><tr><th>รอบบิล</th><th>ห้องพัก</th><th>ยอดเงิน</th><th>วันที่ชำระ</th><th>สถานะ</th><th></th></tr></thead><tbody><% @invoices.each do |invoice| %><tr><td><strong><%= l(invoice.billing_month, format: "%B %Y") %></strong></td><td><span class="room-tag">ห้อง <%= invoice.room.room_number %></span></td><td><strong><%= number_to_currency(invoice.total_amount, unit: "", precision: 2) %> บาท</strong></td><td class="muted"><%= invoice.paid? ? l(invoice.paid_at, format: "%d/%m/%Y") : "-" %></td><td><span class="status-pill <%= invoice.paid? ? 'status-paid' : 'status-pending' %>"><%= invoice.paid? ? 'จ่ายแล้ว' : 'รอชำระ' %></span></td><td><%= invoice.paid? ? link_to("ดูห้อง", rooms_path, class: "text-link") : link_to("ชำระบิล", billing_path, class: "text-link") %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state"><span>◷</span><strong>ยังไม่มีประวัติการชำระ</strong><p>เมื่อสร้างบิล ระบบจะเก็บประวัติไว้ที่หน้านี้</p></div><% end %></section>