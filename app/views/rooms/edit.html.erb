<% content_for :title, "แก้ไขห้องพัก | พักดี" %>
<header class="topbar page-heading"><div><p class="eyebrow">EDIT ROOM</p><h1>แก้ไขห้อง <%= @room.room_number %></h1><p class="muted">อัปเดตข้อมูลห้องพัก</p></div></header>
<section class="content-card form-card">

<%= form_with model: @room do |form| %>

  <div class="form-field">
    <%= form.label :room_number, "เลขห้อง" %>
    <%= form.text_field :room_number %>
  </div>

  <div class="form-field">
    <%= form.label :floor, "ชั้น" %>
    <%= form.number_field :floor %>
  </div>

  <div class="form-field">
    <%= form.label :room_type, "ประเภทห้อง" %>
    <%= form.text_field :room_type %>
  </div>

  <div class="form-field">
    <%= form.label :rent, "ค่าเช่า" %>
    <%= form.number_field :rent %>
  </div>

  <div class="form-field">
    <%= form.label :status, "สถานะ" %>
    <%= form.select :status, ["ว่าง", "มีผู้พัก"], {}, class: "select-input" %>
  </div>

  <div class="form-actions"><%= link_to "ยกเลิก", rooms_path, class: "button button-outline" %><%= form.submit "บันทึกการแก้ไข", class: "button button-primary" %></div>

<% end %></section>