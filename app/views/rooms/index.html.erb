<% content_for :title, "ห้องพัก | พักดี" %>
<header class="topbar page-heading"><div><p class="eyebrow">PROPERTY MANAGEMENT</p><h1>ห้องพัก</h1><p class="muted">จัดการข้อมูลห้องพักและสถานะการเข้าพักทั้งหมด</p></div><%= link_to new_room_path, class: "button button-primary" do %><span>＋</span> เพิ่มห้องพัก<% end %></header>
<section class="content-card room-list-card"><div class="list-toolbar"><div><strong><%= @rooms.count %> ห้อง</strong><span class="muted"> ในระบบ</span></div><div class="filter-pills"><span class="filter-pill active">ทั้งหมด</span><span class="filter-pill"><i class="dot dot-available"></i> ว่าง</span><span class="filter-pill"><i class="dot dot-occupied"></i> มีผู้พัก</span></div></div>
  <% if @rooms.any? %><div class="room-grid"><% @rooms.each do |room| %><article class="room-card"><div class="room-card-top"><span class="room-number">ห้อง <%= room.room_number %></span><span class="status-pill <%= room.status == 'ว่าง' ? 'status-available' : 'status-active' %>"><%= room.status || 'ว่าง' %></span></div><p class="room-type"><%= room.room_type.presence || 'ห้องพักมาตรฐาน' %></p><div class="room-details"><span>ชั้น <strong><%= room.floor %></strong></span><span><strong><%= number_to_currency(room.rent, unit: '', precision: 0) %></strong> บาท/เดือน</span></div><div class="room-actions"><%= link_to "แก้ไข", edit_room_path(room), class: "button button-small button-outline" %><%= button_to "ลบ", room_path(room), method: :delete, class: "button button-small button-danger", data: { turbo_confirm: "ลบห้องพักนี้หรือไม่?" } %></div></article><% end %></div><% else %><div class="empty-state"><span>▦</span><strong>ยังไม่มีห้องพัก</strong><p>เริ่มต้นด้วยการเพิ่มห้องแรกของคุณ</p><%= link_to "เพิ่มห้องพัก", new_room_path, class: "button button-primary" %></div><% end %>
</section>