<% content_for :title, "เพิ่มห้องพัก | พักดี" %>
<header class="topbar page-heading"><div><p class="eyebrow">NEW ROOM</p><h1>เพิ่มห้องพัก</h1><p class="muted">กรอกข้อมูลห้องพักเพื่อเพิ่มเข้าระบบ</p></div></header>
<section class="content-card form-card">

<%= form_with model: @room do |form| %>

  <div class="form-field">
    <%= form.label :room_number, "เลขห้อง" %>
    <%= form.text_field :room_number, placeholder: "เช่น 101" %>
  </div>

  <div class="form-field">
    <%= form.label :floor, "ชั้น" %>
    <%= form.number_field :floor %>
  </div>

  <div class="form-field">
    <%= form.label :room_type, "ประเภทห้อง" %>
    <%= form.text_field :room_type %>
  </div>

  <div class="form-field">
    <%= form.label :rent, "ค่าเช่า" %>
    <%= form.number_field :rent %>
  </div>

  <div class="form-field">
    <%= form.label :status, "สถานะ" %>
    <%= form.select :status, ["ว่าง", "มีผู้พัก"], {}, class: "select-input" %>
  </div>

  <div class="form-actions"><%= link_to "ยกเลิก", rooms_path, class: "button button-outline" %><%= form.submit "เพิ่มห้องพัก", class: "button button-primary" %></div>

<% end %></section>