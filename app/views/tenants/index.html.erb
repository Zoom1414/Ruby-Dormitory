<% content_for :title, "ผู้พักอาศัย | พักดี" %>
<header class="topbar page-heading"><div><p class="eyebrow">TENANT DIRECTORY</p><h1>ผู้พักอาศัย</h1><p class="muted">ข้อมูลผู้พักอาศัยทั้งหมดในหอพัก</p></div><%= link_to new_tenant_path, class: "button button-primary" do %><span>＋</span> เพิ่มผู้พักอาศัย<% end %></header>
<section class="content-card recent-card"><div class="list-toolbar"><strong><%= @tenants.count %> คน</strong><span class="muted"> ผู้พักอาศัยปัจจุบัน</span></div><% if @tenants.any? %><div class="table-wrap"><table><thead><tr><th>ผู้พักอาศัย</th><th>ห้องพัก</th><th>เบอร์โทรศัพท์</th><th>เลขบัตรประชาชน</th><th>สถานะ</th><th></th></tr></thead><tbody><% @tenants.each do |tenant| %><tr><td><span class="table-avatar"><%= tenant.name.to_s.first %></span><strong><%= tenant.name %></strong></td><td><span class="room-tag">ห้อง <%= tenant.room&.room_number || '-' %></span></td><td><%= tenant.phone %></td><td class="muted"><%= tenant.id_card %></td><td><span class="status-pill status-active">เข้าพักอยู่</span></td><td><%= button_to "แจ้งออก", tenant_path(tenant), method: :delete, class: "button button-small button-danger", data: { turbo_confirm: "ยืนยันแจ้งผู้พักคนนี้ออกหรือไม่? ห้องจะกลับเป็นห้องว่าง" } %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state"><span>♙</span><strong>ยังไม่มีข้อมูลผู้พัก</strong><p>เพิ่มผู้พักอาศัยเพื่อเริ่มจัดการข้อมูล</p></div><% end %></section>

<section class="content-card recent-card history-section"><div class="card-heading"><div><h2>ประวัติผู้พักที่ออกแล้ว</h2><p>ข้อมูลถูกเก็บไว้เพื่ออ้างอิงย้อนหลัง</p></div><span class="status-pill status-pending"><%= @former_tenants.count %> รายการ</span></div><% if @former_tenants.any? %><div class="table-wrap"><table><thead><tr><th>ผู้พักอาศัย</th><th>ห้องเดิม</th><th>เบอร์โทรศัพท์</th><th>วันที่ออก</th></tr></thead><tbody><% @former_tenants.each do |tenant| %><tr><td><span class="table-avatar former-avatar"><%= tenant.name.to_s.first %></span><strong><%= tenant.name %></strong></td><td><span class="room-tag">ห้อง <%= tenant.room&.room_number || '-' %></span></td><td><%= tenant.phone %></td><td class="muted"><%= l(tenant.moved_out_at, format: "%d/%m/%Y") %></td></tr><% end %></tbody></table></div><% else %><div class="empty-state compact-empty"><strong>ยังไม่มีประวัติผู้พักออก</strong></div><% end %></section>